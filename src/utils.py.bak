from datetime import datetime
import json
from uuid import uuid4
import logging
from typing import List, Optional, Dict, Any

import boto3
from boto3.dynamodb.conditions import Key

from src.config import env_vars
from src.models import Conversation, Message


class Utils:

    ALLOWED_EXTENSIONS = ["pdf", "docx", "doc", "png", "jpg", "jpeg"]

    @staticmethod
    def log_info(message):
        """_summary_
        Log a simple info message
        """
        logging.getLogger("uvicorn.error").info(msg=f"==> {message}")

    @staticmethod
    def log_debug(message):
        """_summary_
        Log a debug message
        """
        logging.getLogger("uvicorn.error").debug(msg=f"==> {message}")

    @staticmethod
    def log_error(message):
        """_summary_
        Log an error message
        """
        logging.getLogger("uvicorn.error").error(msg=f"==> {message}")

    @staticmethod
    def log_list(elements: List[any]):
        if elements:
            logging.getLogger("uvicorn.error").info(
                msg=f"Displaying all the {len(elements)} elements of the list"
            )
            for i in range(len(elements)):
                logging.getLogger("uvicorn.error").info(
                    msg=f"##### {i} ==> {json.dumps(elements[i], indent=4)}"
                )

    @staticmethod
    def get_logger():
        return logging.getLogger("uvicorn.error")

    @staticmethod
    def get_session():
        # En mode local, on utilise DynamoDB local sans profil AWS
        if env_vars.ENV_NAME.lower() == "local" or not env_vars.AWS_PROFILE:
            return boto3.Session(region_name=env_vars.AWS_REGION_NAME)
        else:
            # En production, on utilise le profil AWS configuré
            return boto3.Session(
                region_name=env_vars.AWS_REGION_NAME, profile_name=env_vars.AWS_PROFILE
            )

    @staticmethod
    def insert_data(item):
        try:
            # Utiliser DynamoDB local en développement si ENV_NAME est "local"
            if env_vars.ENV_NAME.lower() == "local":
                dynamo_client = boto3.client(
                    "dynamodb", 
                    region_name=env_vars.AWS_REGION_NAME,
                    endpoint_url="http://localhost:8000"
                )
            else:
                # Éviter d'utiliser profile_name pour faciliter le développement local
                dynamo_client = boto3.client("dynamodb", region_name=env_vars.AWS_REGION_NAME)
            
            dynamo_client.put_item(
                TableName=env_vars.DYNAMO_TABLE,
                Item=item,
            )
        except Exception as e:
            Utils.log_error(f"Erreur lors de l'insertion dans DynamoDB: {str(e)}")
            # Ne pas faire échouer l'application en cas d'erreur DynamoDB
            # juste journaliser l'erreur
    
    @staticmethod
    def get_dynamo_client():
        """Crée un client DynamoDB en fonction de l'environnement"""
        try:
            # Utiliser DynamoDB local en développement si ENV_NAME est "local"
            if env_vars.ENV_NAME.lower() == "local":
                return boto3.client(
                    "dynamodb", 
                    region_name=env_vars.AWS_REGION_NAME,
                    endpoint_url="http://localhost:8000"
                )
            else:
                # Éviter d'utiliser profile_name pour faciliter le développement local
                return boto3.client("dynamodb", region_name=env_vars.AWS_REGION_NAME)
        except Exception as e:
            Utils.log_error(f"Erreur lors de l'initialisation du client DynamoDB: {str(e)}")
            return None
    
    @staticmethod
    def save_conversation(conversation: Conversation) -> None:
        """Sauvegarde une conversation dans DynamoDB"""
        try:
            dynamo_client = Utils.get_dynamo_client()
            if dynamo_client:
                dynamo_client.put_item(
                    TableName=env_vars.DYNAMO_TABLE,
                    Item=conversation.to_dynamo_item(),
                )
        except Exception as e:
            Utils.log_error(f"Erreur lors de la sauvegarde de conversation: {str(e)}")
            # Ne pas faire échouer l'application
    
    @staticmethod
    def get_conversation(user_id: str, conversation_id: str) -> Optional[Conversation]:
        """Récupère une conversation par son ID utilisateur et ID de conversation"""
        try:
            dynamo_client = Utils.get_dynamo_client()
            if not dynamo_client:
                return None
                
            response = dynamo_client.get_item(
                TableName=env_vars.DYNAMO_TABLE,
                Key={
                    "PK": {"S": f"USER#{user_id}"},
                    "SK": {"S": f"CONV#{conversation_id}"}
                }
            )
            
            if "Item" not in response:
                return None
            
            return Conversation.from_dynamo_item(response["Item"])
        except Exception as e:
            Utils.log_error(f"Erreur lors de la récupération de conversation: {str(e)}")
            return None
    
    @staticmethod
    def get_user_conversations(user_id: str) -> List[Conversation]:
        """Récupère toutes les conversations d'un utilisateur"""
        try:
            dynamo_client = Utils.get_dynamo_client()
            if not dynamo_client:
                return []
            
            # Query DynamoDB pour trouver toutes les conversations de l'utilisateur
            response = dynamo_client.query(
                TableName=env_vars.DYNAMO_TABLE,
                KeyConditionExpression="PK = :pk AND begins_with(SK, :sk_prefix)",
                ExpressionAttributeValues={
                    ":pk": {"S": f"USER#{user_id}"},
                    ":sk_prefix": {"S": "CONV#"}
                }
            )
            
            conversations = []
            for item in response.get("Items", []):
                try:
                    conversations.append(Conversation.from_dynamo_item(item))
                except Exception as item_error:
                    Utils.log_error(f"Erreur lors de la conversion d'une conversation: {str(item_error)}")
                    continue
            
            return conversations
            
        except Exception as e:
            Utils.log_error(f"Erreur lors de la récupération des conversations: {str(e)}")
            return []
        
    @staticmethod
    def create_new_conversation(user_id: str, username: Optional[str] = None) -> Optional[Conversation]:
        """Crée une nouvelle conversation pour un utilisateur"""
        try:
            conversation_id = str(uuid4())
            conversation = Conversation(
                conversation_id=conversation_id,
                user_id=user_id,
                username=username,
                created_at=datetime.utcnow(),
                updated_at=datetime.utcnow()
            )
            
            # Essayer de sauvegarder la conversation
            Utils.save_conversation(conversation)
            Utils.log_info(f"Nouvelle conversation créée: {conversation_id} pour l'utilisateur: {user_id}")
            return conversation
            
        except Exception as e:
            Utils.log_error(f"Erreur lors de la création d'une nouvelle conversation: {str(e)}")
            return None