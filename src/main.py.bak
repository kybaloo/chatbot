from fastapi import FastAPI, BackgroundTasks, HTTPException, Request
from fastapi.middleware.cors import CORSMiddleware
from contextlib import asynccontextmanager
from mangum import Mangum
import json, boto3, threading
from mistralai import Mistral
from uuid import uuid4
from datetime import datetime
import logging
import sys
import requests
import os
from typing import Dict, Any

from .config import env_vars
from .utils import Utils
from .models import Conversation, Message

# Configuration du logging
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    handlers=[logging.StreamHandler(sys.stdout)]
)

# Initialisation du client Mistral
api_key = env_vars.MISTRAL_API_KEY
model = "mistral-small-latest"
client = Mistral(api_key=api_key)

# Import conditionnel du bot Telegram pour éviter les erreurs de dépendance
telegram_bot_instance = None
if env_vars.TELEGRAM_BOT_TOKEN:
    from .telegram_bot import TelegramBot


@asynccontextmanager
async def app_lifespan(application: FastAPI):
    Utils.log_info("Starting the application")
    
    # Initialiser l'instance du bot Telegram si configuré
    global telegram_bot_instance
    if env_vars.TELEGRAM_BOT_TOKEN:
        Utils.log_info("Initializing Telegram bot instance for webhook mode")
        telegram_bot_instance = TelegramBot()
    else:
        Utils.log_info("Telegram bot not configured (TELEGRAM_BOT_TOKEN is missing)")
    
    yield
    
    Utils.log_info("Shutting down the application")


app = FastAPI(
    title="ChatBot API",
    description="Chatbot API description",
    version="1.0.0",
    lifespan=app_lifespan,
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


@app.get("/")
async def root():
    return {"msg": "Hello World"}

@app.get("/chat")
async def chat(question: str, user_id: str = None, conversation_id: str = None):
    """
    Endpoint pour discuter avec le bot
    Si user_id et conversation_id sont fournis, la conversation sera sauvegardée dans DynamoDB
    """
    # Récupérer ou créer une conversation si user_id est fourni
    conversation = None
    if user_id:
        if conversation_id:
            conversation = Utils.get_conversation(user_id, conversation_id)
        
        if not conversation:
            conversation = Utils.create_new_conversation(user_id)
            conversation_id = conversation.conversation_id
        
        # Ajouter le message utilisateur à la conversation
        conversation.add_message(role="user", content=question)
    
    # Préparer les messages pour l'API Mistral
    messages = []
    if conversation and conversation.messages:
        for msg in conversation.messages:
            messages.append({
                "role": msg.role,
                "content": msg.content
            })
    else:
        messages = [{"role": "user", "content": question}]
    
    # Appeler l'API Mistral
    chat_response = client.chat.complete(
        model=model,
        messages=messages
    )
    
    # Extraire la réponse
    assistant_response = chat_response.choices[0].message.content
    
    # Si une conversation est en cours, ajouter la réponse et sauvegarder
    if conversation:
        conversation.add_message(role="assistant", content=assistant_response)
        Utils.save_conversation(conversation)
    
    # Format de réponse compatible avec le code existant
    response = {
        "id": {
            "S": f"{chat_response.id}",
        },
        "question": {
            "S": f"{question}",
        },
        "answer": {
            "S": f"{assistant_response}",
        }
    }
    
    # Conserver l'ancienne méthode d'insertion pour la rétrocompatibilité
    Utils.insert_data(response)
    
    # Retourner la réponse avec des informations supplémentaires si disponibles
    result = {
        "id": chat_response.id,
        "question": question,
        "answer": assistant_response,
    }
    
    if conversation_id:
        result["conversation_id"] = conversation_id
    
    return result

@app.get("/conversations/{user_id}")
async def get_user_conversations(user_id: str):
    """Récupère toutes les conversations d'un utilisateur"""
    conversations = Utils.get_user_conversations(user_id)
    
    # Convertir les conversations en format JSON pour l'API
    result = []
    for conv in conversations:
        result.append({
            "conversation_id": conv.conversation_id,
            "created_at": conv.created_at.isoformat(),
            "updated_at": conv.updated_at.isoformat(),
            "message_count": len(conv.messages)
        })
    
    return {"conversations": result}

@app.get("/conversations/{user_id}/{conversation_id}")
async def get_conversation(user_id: str, conversation_id: str):
    """Récupère une conversation spécifique"""
    conversation = Utils.get_conversation(user_id, conversation_id)
    
    if not conversation:
        return {"error": "Conversation not found"}
    
    # Convertir la conversation en format JSON pour l'API
    messages = []
    for msg in conversation.messages:
        messages.append({
            "role": msg.role,
            "content": msg.content,
            "timestamp": msg.timestamp.isoformat()
        })
    
    return {
        "conversation_id": conversation.conversation_id,
        "user_id": conversation.user_id,
        "username": conversation.username,
        "created_at": conversation.created_at.isoformat(),
        "updated_at": conversation.updated_at.isoformat(),
        "messages": messages
    }


@app.post("/webhook/telegram")
async def telegram_webhook(request: Request):
    """
    Endpoint webhook pour recevoir les mises à jour de Telegram
    """
    if not telegram_bot_instance:
        raise HTTPException(status_code=500, detail="Telegram bot not initialized")
    
    try:
        # Récupérer les données JSON de la requête
        update_data = await request.json()
        Utils.log_info(f"Received telegram update: {update_data}")
        
        # Traiter la mise à jour avec le bot Telegram
        await telegram_bot_instance.process_update(update_data)
        
        return {"status": "ok"}
    
    except Exception as e:
        Utils.log_error(f"Error processing telegram webhook: {str(e)}")
        raise HTTPException(status_code=500, detail="Internal server error")


handler = Mangum(app)